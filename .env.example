# Copy to .env (chmod 600) and fill in. `.env` is gitignored — it never reaches the repo.
# In production the app refuses to start if a secret is missing or a placeholder.

# --- application -------------------------------------------------------------
# dev locally; deploy-prod.sh refuses anything but production on the server.
APP_ENV=dev                          # dev | production
# Each app on a shared host needs its own ports. APP_PORT_BLUE is also the initial proxy_pass port in
# deploy/nginx-rag_my_docs.conf — change both together.
APP_PORT_BLUE=8140
APP_PORT_GREEN=8141
# Sign-in links are built from this, never from the request's Host header. Production: https://<your domain>
APP_BASE_URL=http://localhost:8140

# Only for running the app outside Compose (uvicorn on the laptop): Compose builds
# its own DATABASE_URL from the DB_* values below and overrides this one.
DATABASE_URL=postgresql://user_rag_my_docs:CHANGE_ME_token_urlsafe_24@127.0.0.1:5540/db_rag_my_docs

# Fernet key sealing the documents, their names and the emails at rest.
# KEEP A COPY OUTSIDE THE SERVER, beside the backup key: a restored backup is
# unreadable without it — every document in it is sealed with this key.
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=CHANGE_ME_fernet_key

# The one person who may sign in. Their account is made at startup, every
# other account is disabled, and the corpus (the IRS publications) is kept
# under it. Empty: nobody can sign in and no publication is loaded.
BOOTSTRAP_ADMIN_EMAIL=

# --- database ----------------------------------------------------------------
DB_NAME=db_rag_my_docs
DB_USER=user_rag_my_docs
DB_PORT=5540                         # host loopback port, unique per app
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
DB_PASSWORD=CHANGE_ME_token_urlsafe_24

# --- email (magic links) -----------------------------------------------------
# The only outbound channel: sign-in is a link sent by email, never a password.
# Empty SMTP_HOST on a laptop writes the links to the log; production refuses it.
# Any SMTP relay with STARTTLS (Amazon SES credentials are region-bound).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=rag-my-docs@example.com

# --- document processing ------------------------------------------------------
# How PDFs are cut into retrieval chunks, in word-and-punctuation tokens (README).
# Changing them marks processed documents as stale; reprocess them from Inspect.
CHUNK_TARGET_TOKENS=200
CHUNK_MAX_TOKENS=350
CHUNK_MIN_TOKENS=75
CHUNK_OVERLAP_SENTENCES=1

# --- embeddings and semantic search -------------------------------------------
# The local model (Sentence Transformers). Its weights are baked into the image at
# build time and the app runs offline: no document or question leaves the server.
# Changing it needs a rebuild (the same name is passed to the image build) and a
# model of 384 dimensions; documents are then re-indexed at the next start.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Prepended to every question, never to a passage: BGE's retrieval instruction.
EMBEDDING_QUERY_PREFIX="Represent this sentence for searching relevant passages: "
EMBEDDING_BATCH_SIZE=32
